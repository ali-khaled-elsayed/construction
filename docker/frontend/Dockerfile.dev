# =============================================================================
# Next.js frontend — development image with hot reload
# Build context: repository root (.)
# =============================================================================

FROM node:22-alpine

WORKDIR /app

# Dependencies installed at container start or via volume + npm ci in entrypoint
RUN apk add --no-cache libc6-compat

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
# Required for file watching on Docker Desktop (Windows/macOS bind mounts)
ENV WATCHPACK_POLLING=true
ENV CHOKIDAR_USEPOLLING=true

EXPOSE 3000

CMD ["sh", "-c", "npm ci && npm run dev -- --hostname 0.0.0.0 --port 3000"]
